{
  "name": "trinity-recorder",
  "version": "1.0.0",
  "description": "MilkChoco Map Waypoint Recorder",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "start": "electron dist/main.js",
    "dist": "electron-builder --win portable",
    "copy-assets": "cp src/renderer.html dist/ && cp -r scripts dist/"
  },
  "dependencies": {
    "electron": "^28.0.0",
    "frida": "^16.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.trinity.recorder",
    "productName": "Trinity Recorder",
    "win": {"target": "portable"}
  }
}