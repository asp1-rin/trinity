{
  "name": "trinity-bot",
  "version": "1.0.0",
  "description": "MilkChoco Multi-Instance Clan War Bot",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "start": "electron dist/main.js",
    "dist": "electron-builder --win portable",
    "copy-assets": "cp -r src/renderer.html dist/ && cp -r scripts dist/ && cp -r waypoints dist/"
  },
  "dependencies": {
    "electron": "^28.0.0",
    "frida": "^16.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "electron-builder": "^24.0.0",
    "@types/node": "^20.0.0",
    "@types/frida-gum": "^18.0.0"
  },
  "build": {
    "appId": "com.trinity.bot",
    "productName": "Trinity Bot",
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "extraResources": [
      {"from": "scripts", "to": "scripts"},
      {"from": "waypoints", "to": "waypoints"}
    ]
  }
}